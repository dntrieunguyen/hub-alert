# ==============================================================================
# 1. SERVER & SYSTEM CONFIGURATION
# ==============================================================================
NODE_ENV=production
PORT=1200
# ACCESS_KEY=your_secret_access_key

# ==============================================================================
# 2. CACHE CONFIGURATION
# ==============================================================================
# Cache type: 'memory' (default) or 'redis' (recommended if you have a Redis server)
CACHE_TYPE=memory
CACHE_EXPIRE=3600
# REDIS_URL=redis://default:password@localhost:6379/

# ==============================================================================
# 3. COLLECTOR SCHEDULER & NOTIFICATIONS (HUB-ALERT)
# ==============================================================================
# Auto start the background collector polling service on boot
COLLECTOR_AUTO_START=true

# Internal RSSHub URL used by the collector scheduler to query RSS routes
RSSHUB_BASE_URL=http://localhost:1200

# Google Chat Webhook Notification Configuration
GOOGLE_CHAT_ENABLED=false
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_CHAT_MIN_IMPACT_SCORE=80

# ==============================================================================
# 4. TOP 10 CRYPTO INTELLIGENCE DIGEST CONFIGURATION
# ==============================================================================
CRYPTO_DIGEST_ENABLED=true
CRYPTO_DIGEST_INTERVAL_MINUTES=180
CRYPTO_DIGEST_LOOKBACK_HOURS=6
CRYPTO_DIGEST_MAX_ITEMS=10
CRYPTO_DIGEST_MIN_CREDIBILITY=70
CRYPTO_DIGEST_MIN_RANKING_SCORE=65

# Immediate Critical Alert Bypass (Gửi cảnh báo khẩn cấp ngay lập tức nếu Impact >= 95)
CRYPTO_CRITICAL_ALERT_ENABLED=true
CRYPTO_CRITICAL_ALERT_THRESHOLD=95

# Scheduled Digest Timezone & Windows (05:00, 11:00, 17:00 Asia/Ho_Chi_Minh)
CRYPTO_DIGEST_TIMEZONE=Asia/Ho_Chi_Minh
CRYPTO_DIGEST_MORNING_CRON=0 5 * * *
CRYPTO_DIGEST_NOON_CRON=0 11 * * *
CRYPTO_DIGEST_EVENING_CRON=0 17 * * *
CRYPTO_DIGEST_FALLBACK_LOOKBACK_HOURS=12

# ==============================================================================
# 5. AI CRYPTO INTELLIGENCE & REALTIME HOT NEWS (DEEPSEEK)
# ==============================================================================
AI_NEWS_ENABLED=true
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_NEWS_LANGUAGE=vi
AI_NEWS_MAX_CANDIDATES=30
AI_NEWS_MAX_DIGEST_ITEMS=10
AI_NEWS_MIN_CREDIBILITY=70
AI_NEWS_MIN_IMPACT_SCORE=60

# Realtime Hot News Alert Policy (Pushes immediately without waiting for schedule)
AI_HOT_NEWS_ENABLED=true
AI_HOT_NEWS_MIN_CREDIBILITY=90
AI_HOT_NEWS_MIN_IMPACT_SCORE=90
AI_HOT_NEWS_MIN_CONFIDENCE=0.90

# ==============================================================================
# 6. DATA SOURCES AUTHENTICATION
# ==============================================================================
# Web auth_token cookie(s) from logged-in Twitter/X account (comma-separated for multiple)
# Required for Collector's X sources to fetch tweets
TWITTER_AUTH_TOKEN=

# Or official Twitter Developer credentials (optional alternative)
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=

# ==============================================================================
# 7. BROWSERLESS & PROXY (OPTIONAL)
# ==============================================================================
# Remote Playwright / Browserless endpoint (if using external headless browser)
# PLAYWRIGHT_WS_ENDPOINT=ws://browserless:3000

# Proxy server for bypassing IP blocks/rate limits
# PROXY_URI=http://user:pass@proxy-ip:port
